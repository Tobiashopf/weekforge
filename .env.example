# Copy to .env and adjust. Never commit the real .env.
WEEKFORGE_DATABASE_URL=sqlite:///./weekforge.db

# Web Push (optional). Leave the keys as they are and Weekforge generates its own on first
# use and keeps them in the database. Set both only if you want to bring your own
# (base64url raw P-256 keys).
VAPID_PUBLIC_KEY=your-public-key-here
VAPID_PRIVATE_KEY=your-private-key-here
# Contact sent to push services (Google, Mozilla, Apple) with each notification.
VAPID_SUBJECT=mailto:you@example.com
